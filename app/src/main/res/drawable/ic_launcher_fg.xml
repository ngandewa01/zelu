<?xml version="1.0" encoding="utf-8"?>
<!-- The Zelu mark ("Ledger Z"): a Z whose slanted line runs on as two shorter lines, like entries in a ledger.
     Drawn in the 108 grid of an adaptive icon and kept inside its safe circle (radius 33 around the centre).
     Also the themed (monochrome) icon, where Android draws it in one colour. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M33,34 H75 L35,74"
        android:strokeColor="@color/zelu_brand_cream"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="7" />
    <path
        android:pathData="M75,49 L50,74"
        android:strokeColor="@color/zelu_brand_tan"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="7" />
    <path
        android:pathData="M75,64 L65,74"
        android:strokeColor="@color/zelu_brand_tan_deep"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="7" />
</vector>
